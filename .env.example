# Postgres connection string (Supabase: Project Settings > Database > Connection string > URI)
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.xxxx.supabase.co:5432/postgres
# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Owner account (created/updated on every start)
ADMIN_USER=gouda_co
ADMIN_PASS=
ADMIN_EMAIL=owner@example.com
# SMTP for real OTP emails (Gmail app password, Brevo, Resend SMTP, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=
MAIL_FROM="ASAD <you@gmail.com>"
